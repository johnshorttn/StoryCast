# Copy to .env and fill in. Never commit real keys.

# xAI TTS + Grok draft helper (admin)
XAI_API_KEY=

# Optional self-hosted TTS adapters. Each accepts POST JSON with text, voice_id,
# language, and format, and returns audio bytes.
# KOKORO_TTS_URL=http://127.0.0.1:8880/v1/audio/speech
# SHERPA_TTS_URL=http://127.0.0.1:8890/tts

# Optional durable beat-audio cache. Serve STORY_AUDIO_ROOT from the matching
# public URL (for example with nginx). Both settings are required.
# STORY_AUDIO_ROOT=/var/lib/storycast/audio
# STORY_AUDIO_PUBLIC_URL=https://media.example.com/storycast/audio

# Local StoryCast rewrite model through an OpenAI-compatible server.
# Ollama example: http://127.0.0.1:11434/v1 with qwen3:4b
# STORY_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# STORY_MODEL_NAME=qwen3:4b
# STORY_MODEL_API_KEY=

# Postgres is required for durable production stories. If unset, local development
# uses an in-memory PGLite database that resets with the server process.
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/storycast

# Comma-separated emails bootstrapped as StoryCast owners. Owners include
# financial reporting, billing, role management, moderation, and developer access.
# STORYCAST_OWNER_EMAILS=owner@example.com

# Optional public hostname for PWA / OG
# VITE_PUBLIC_HOSTNAME=example.com
